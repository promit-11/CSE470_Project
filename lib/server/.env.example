PORT=8080
NODE_ENV=development
DB_URL=mongodb://127.0.0.1:27017
DB_NAME=ielts_mock_platform
JWT_ACCESS_SECRET=replace_with_strong_access_secret
JWT_REFRESH_SECRET=replace_with_strong_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
CLIENT_ORIGIN=http://localhost:3000
JSON_BODY_LIMIT=1mb
URLENCODED_BODY_LIMIT=1mb
MEDIA_STORAGE_PROVIDER=local
MEDIA_UPLOAD_DIR=uploads
MEDIA_PUBLIC_BASE_PATH=/media
MEDIA_MAX_IMAGE_BYTES=5242880
MEDIA_MAX_AUDIO_BYTES=20971520
MEDIA_MAX_FILES_PER_REQUEST=10
PLATFORM_ADMIN_SEED_EMAIL=admin@g.com
PLATFORM_ADMIN_SEED_PASSWORD=Admin@12345
